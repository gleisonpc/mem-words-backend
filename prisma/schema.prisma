// Schema do mem-words-backend.
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  // Guardado sempre em minúsculas para que o índice único seja
  // case-insensitive na prática.
  email        String   @unique @db.VarChar(255)
  // Hash bcrypt — a senha em texto puro nunca é persistida.
  passwordHash String   @map("password_hash")
  // Sequência de dias seguidos com ao menos uma nota de revisão
  // registrada, e o dia (calendário UTC) da última — ver
  // `src/lib/streak.ts` e o change `add-home-dashboard-summary`.
  currentStreak Int       @default(0) @map("current_streak")
  lastActiveOn  DateTime? @map("last_active_on") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  decks         Deck[]

  @@map("users")
}

/// Refresh tokens emitidos no login.
///
/// Apenas o hash SHA-256 do token é persistido: um vazamento do banco não
/// permite reutilizar os tokens. A linha é mantida após a revogação para
/// que a rotação consiga detectar reuso de um token já gasto.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Deck {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(120)
  sourceLanguage String   @map("source_language") @db.VarChar(10)
  targetLanguage String   @map("target_language") @db.VarChar(10)
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([userId])
  @@map("decks")
}

/// `new`: ainda não estudado. `learning`: nos passos curtos de aprendizado
/// (minutos). `review`: graduado, intervalo em dias. Suspensão é ortogonal
/// a este enum — ver campo `suspended` em `Card` e o change
/// `add-card-suspension-and-difficulty`.
enum CardState {
  new
  learning
  review

  @@map("card_state")
}

/// Nota de uma revisão (`review.service.ts`). Persistida em `Card.lastGrade`
/// só para classificar "difícil" (`lastGrade: hard` em `review`) — não é um
/// histórico completo, ver design.md do change
/// `add-card-suspension-and-difficulty`.
enum ReviewGrade {
  again
  hard
  good
  easy

  @@map("review_grade")
}

model Card {
  id                 String       @id @default(uuid()) @db.Uuid
  word               String       @db.VarChar(200)
  translation        String       @db.VarChar(200)
  partOfSpeech       String?      @map("part_of_speech") @db.VarChar(40)
  synonyms           String[]     @default([])
  exampleSentence    String?      @map("example_sentence")
  exampleTranslation String?      @map("example_translation")
  personalNote       String?      @map("personal_note")
  state              CardState    @default(new)
  // Agendamento de revisão espaçada — ver src/lib/scheduling.ts.
  // `learningStep`: índice do passo atual em `learning` (irrelevante fora
  // desse estado). `easeFactor`: multiplicador do intervalo em `review`.
  // `intervalDays`: intervalo atual, em dias (fracionário só por causa do
  // fator de facilidade). `dueAt`: quando o card volta a ficar pronto para
  // revisão; `null` enquanto o card nunca recebeu nota (`new`).
  learningStep       Int          @default(0) @map("learning_step")
  easeFactor         Float        @default(2.5) @map("ease_factor")
  intervalDays       Float        @default(0) @map("interval_days")
  dueAt              DateTime?    @map("due_at")
  // Suspender é uma ação manual e reversível, ortogonal ao agendamento
  // acima — suspender/reativar não toca em nenhum dos campos de cima.
  suspended          Boolean      @default(false)
  // Nota da revisão mais recente, `null` até a primeira (`state: new`).
  // Usada só para classificar "difícil" (ver `card.service.ts`).
  lastGrade          ReviewGrade? @map("last_grade")
  deckId             String       @map("deck_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId])
  @@index([dueAt])
  @@map("cards")
}
