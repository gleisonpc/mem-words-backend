# ── Servidor ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Origens permitidas pelo CORS.
# Vazio ou "*" libera qualquer origem (configuração atual).
# Depois basta informar as URLs do frontend separadas por vírgula, ex.:
# CORS_ORIGIN=https://app.mem-words.com,http://localhost:5173
CORS_ORIGIN=*

# ── Banco de dados (PostgreSQL) ─────────────────────────────────────────
# Em produção, use a connection string "pooled" do Neon.
DATABASE_URL="postgresql://usuario:senha@host/mem_words?sslmode=require"

# Opcional: conexão DIRETA, usada apenas pelas migrations.
# Provedores com pool (Neon) expõem um endpoint agrupado que não serve para
# migrations. No Neon é a mesma URL sem "-pooler" no host.
# Se não for informada, as migrations usam a DATABASE_URL acima.
# DIRECT_DATABASE_URL="postgresql://usuario:senha@host-direto/mem_words?sslmode=require"

# ── Autenticação (JWT) ──────────────────────────────────────────────────
# OBRIGATÓRIAS: a aplicação não sobe sem elas.
# Gere cada uma com: openssl rand -base64 48
# Os dois segredos precisam ser DIFERENTES entre si.
JWT_ACCESS_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_REFRESH_SECRET="troque-por-outro-segredo-longo-e-aleatorio"

# Validade dos tokens (formatos: 30s, 15m, 24h, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
