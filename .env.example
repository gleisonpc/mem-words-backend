# Porta em que o servidor HTTP escuta
PORT=3000

# Ambiente de execução (development | test | production)
NODE_ENV=development

# Origens permitidas pelo CORS.
# Vazio ou "*" libera qualquer origem (configuração atual).
# Depois basta informar as URLs do frontend separadas por vírgula, ex.:
# CORS_ORIGIN=https://app.mem-words.com,http://localhost:5173
CORS_ORIGIN=*
