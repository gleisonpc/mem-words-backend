{
  "name": "mem-words-backend",
  "version": "1.0.0",
  "description": "Backend para aplicação que ajuda a memorizar palavras",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gleisonpc/mem-words-backend.git"
  },
