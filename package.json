  "bugs": {
    "url": "https://github.com/gleisonpc/mem-words-backend/issues"
  },
  "homepage": "https://github.com/gleisonpc/mem-words-backend#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "types": "dist/server.d.ts",
  "engines": {
    "node": ">=22"
  }
